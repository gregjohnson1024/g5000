{
  "name": "autopilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "lint:overhaul": "node scripts/lint-overhaul.mjs",
    "lint:overhaul:strict": "node scripts/lint-overhaul.mjs --strict",
    "format": "prettier --write .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "prettier": "^3.4",
    "tsx": "^4",
    "typescript": "^5.7",
    "vitest": "^2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@canboat/canboatjs": "^3.20.0",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.36.4",
    "rxjs": "^7.8.2",
    "serialport": "^12.0.0"
  }
}
